meta {
  name: 405 method not allowed
  type: http
  seq: 2
}

delete {
  url: {{base_url}}/problems
  body: none
  auth: none
}

tests {
  test("status is 405", function () {
    expect(res.status).to.equal(405);
  });
  test("standard error body", function () {
    expect(res.body.error).to.equal("METHOD_NOT_ALLOWED");
    expect(res.body.message).to.be.a("string");
  });
}
