meta {
  name: List problems by topic
  type: http
  seq: 3
}

get {
  url: {{base_url}}/problems?topic=stack
  body: none
  auth: none
}

params:query {
  topic: stack
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
  test("only stack problems come back", function () {
    expect(res.body.length).to.be.above(0);
    res.body.forEach((problem) => expect(problem.topic).to.equal("stack"));
  });
}
